{
  "compilerOptions": {
    "target": "es2022",
    "module": "commonjs",
    "moduleResolution": "node",
    "outDir": "dist",
    "rootDir": ".",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "types": ["node"]
  },
  "include": [
    "server.ts",
    "src/server/**/*.ts",
    "src/lib/db.ts",
    "src/lib/auth.ts",
    "src/lib/siteAdmin.ts",
    "src/lib/uploads.ts",
    "src/lib/roles.ts",
    "src/lib/rateLimit.ts"
  ],
  "exclude": ["node_modules", ".next", "dist"]
}
